{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/phone-socket.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/games/shadow-puppet-uprising/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/games/shadow-puppet-uprising/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
